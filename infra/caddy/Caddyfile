# FNB Super App v3 — Caddy Reverse Proxy Configuration
# Place at /etc/caddy/Caddyfile or run: caddy run --config infra/caddy/Caddyfile

# Global settings
{
	email {$CADDY_EMAIL:admin@lokaespresso.my}
	admin off
}

# Admin Dashboard (Next.js — port 13830)
{$ADMIN_DOMAIN:admin.lokaespresso.my} {
	reverse_proxy admin-portal:3000

	header {
		X-Frame-Options DENY
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
	}
}

# Customer PWA (Next.js — port 13810)
{$APP_DOMAIN:app.lokaespresso.my} {
	handle /api/v1/* {
		reverse_proxy backend:13800
	}
	handle /uploads/* {
		root * /app/uploads
		file_server
	}
	handle {
		reverse_proxy customer-pwa:3012
	}

	header {
		X-Frame-Options DENY
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
	}
}

# Staff Portal (Next.js — port 13820)
{$STAFF_DOMAIN:staff.lokaespresso.my} {
	handle /api/v1/* {
		reverse_proxy backend:13800
	}
	handle {
		reverse_proxy staff-portal:3000
	}

	header {
		X-Frame-Options DENY
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
	}
}

# API Backend (FastAPI — port 13800)
{$API_DOMAIN:api.lokaespresso.my} {
	reverse_proxy backend:13800

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
	}

	# CORS preflight caching
	@options {
		method OPTIONS
	}
	header @options {
		Access-Control-Allow-Origin {$CORS_ORIGINS:https://app.lokaespresso.my}
		Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
		Access-Control-Allow-Headers "Content-Type, Authorization, Accept-Language"
		Access-Control-Allow-Credentials "true"
		Access-Control-Max-Age "86400"
	}

	# Upload size limit
	request_body {
		max_size 10MB
	}
}

# Static uploads served directly by Caddy
{$UPLOADS_DOMAIN:uploads.lokaespresso.my} {
	root * /app/uploads
	file_server
}
