# Customer PWA Environment
# Local dev: full URL to backend (no reverse proxy between frontend and backend)
NEXT_PUBLIC_API_URL=http://localhost:13800/api
# Container: use /api (Caddy reverse proxy handles API routing)
# NEXT_PUBLIC_API_URL=/api

# Public URL of this PWA (used for metadata/deep links when server-side rendering)
NEXT_PUBLIC_APP_URL=https://app.lokaespresso.com

PORT=13810
HOST=0.0.0.0
