# Customer PWA Environment
# Server-side absolute URL to the backend (used by middleware)
API_PROXY_URL=http://127.0.0.1:13800/api
# Public-facing API path (browser uses same-origin /api when behind Caddy)
NEXT_PUBLIC_API_URL=/api

# Public URL of this PWA (used for metadata/deep links when server-side rendering)
NEXT_PUBLIC_APP_URL=https://app.lokaespresso.com

PORT=13810
HOST=0.0.0.0
