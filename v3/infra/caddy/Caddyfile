# FNB v3 Caddyfile — Reverse Proxy + TLS
# Domain values are injected via environment variables so the same image
# can be deployed on production (lokaespresso.com, the default below),
# the legacy dev server (loyaltysystem.uk) or future brand servers
# without editing this file.
#
# Only admin/staff/app subdomains are used by this project.
# loyaltysystem.uk / www.loyaltysystem.uk are NOT served here.

{
    email {$CADDY_EMAIL:admin@lokaespresso.my}
    admin off
}

# HTTP health responder for Docker / load balancer checks
:80 {
    handle /health {
        respond "ok" 200
    }
    handle {
        redir https://{host}{uri}
    }
}

# Customer PWA
{$APP_DOMAIN:app.lokaespresso.com} {
    handle /api/* {
        reverse_proxy backend:13800
    }
    handle /uploads/* {
        reverse_proxy backend:13800
    }
    handle /manifest.json {
        reverse_proxy customer-pwa:13810
    }
    handle /sw.js {
        reverse_proxy customer-pwa:13810
    }
    handle /offline.html {
        reverse_proxy customer-pwa:13810
    }
    handle /icon-* {
        reverse_proxy customer-pwa:13810
    }
    handle {
        reverse_proxy customer-pwa:13810
    }

    encode gzip

    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
}

# Admin portal
{$ADMIN_DOMAIN:admin.lokaespresso.com} {
    handle /api/* {
        reverse_proxy backend:13800
    }
    handle /uploads/* {
        reverse_proxy backend:13800
    }
    handle {
        reverse_proxy admin-portal:3000
    }

    encode gzip

    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
}

# Staff portal
{$STAFF_DOMAIN:staff.lokaespresso.com} {
    handle /api/* {
        reverse_proxy backend:13800
    }
    handle /uploads/* {
        reverse_proxy backend:13800
    }
    handle {
        reverse_proxy staff-portal:3000
    }

    encode gzip

    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
}
