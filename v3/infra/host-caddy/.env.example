# Host Caddy environment variables
# Source this file before reloading Caddy, or set the variables in your init system.

APP_DOMAIN=app.lokaespresso.com
ADMIN_DOMAIN=admin.lokaespresso.com
STAFF_DOMAIN=staff.lokaespresso.com

# Cloudflare Origin CA certificate paths (or remove tls lines in .conf to use Caddy auto-TLS)
TLS_CERT_PATH=/etc/ssl/certs/lokaespresso-origin.pem
TLS_KEY_PATH=/etc/ssl/private/lokaespresso-origin.key
