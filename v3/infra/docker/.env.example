# Database
POSTGRES_USER=fnb_user
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=fnb_enterprise_v3

# Redis
REDIS_PASSWORD=change-me-to-a-strong-password

# JWT (minimum 32 characters)
JWT_SECRET=change-me-to-a-random-64-char-string

# Environment
ENVIRONMENT=production
APP_NAME=FNB Enterprise v3
DEBUG=false

# CORS (comma-separated origins — use exact HTTPS domains in production)
CORS_ORIGINS=https://app.loyaltysystem.uk,https://admin.loyaltysystem.uk,https://staff.loyaltysystem.uk

# Public domains — change these for each server/brand
# Only admin/staff/app subdomains are used by this project.
APP_DOMAIN=app.loyaltysystem.uk
ADMIN_DOMAIN=admin.loyaltysystem.uk
STAFF_DOMAIN=staff.loyaltysystem.uk

# Trusted hosts (required in production)
TRUSTED_HOSTS=app.loyaltysystem.uk,admin.loyaltysystem.uk,staff.loyaltysystem.uk

# Uploads
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE_MB=10

# Webhooks
WEBHOOK_API_KEY=whk-change-me
WEBHOOK_SIGNING_SECRET=whs-change-me

# TLS contact email
CADDY_EMAIL=admin@lokaespresso.my
