# Admin Portal Environment
# Local dev: full URL to backend (no reverse proxy between frontend and backend)
NEXT_PUBLIC_API_URL=http://localhost:13800/api
# Container: use /api (Caddy reverse proxy handles API routing)
# NEXT_PUBLIC_API_URL=/api

# Public domains of the three frontends (used for image domains and version checks)
NEXT_PUBLIC_ADMIN_DOMAIN=admin.lokaespresso.com
NEXT_PUBLIC_APP_DOMAIN=app.lokaespresso.com
NEXT_PUBLIC_STAFF_DOMAIN=staff.lokaespresso.com

# Optional: additional image domains (comma-separated)
# NEXT_PUBLIC_IMAGE_DOMAINS=cdn.lokaespresso.com

# URLs to staff/customer version.json for the Version Control page
NEXT_PUBLIC_STAFF_VERSION_URL=https://staff.lokaespresso.com/version.json
NEXT_PUBLIC_CUSTOMER_VERSION_URL=https://app.lokaespresso.com/version.json

PORT=3000
HOST=0.0.0.0
