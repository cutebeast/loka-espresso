# FNB Enterprise v3 — Backend Environment
# NOTE: All runtime app settings (OTP bypass, feature flags, business rules)
# are stored in the `platform_config` table and managed via the admin API.
# This file is for infrastructure secrets and connection strings only.

# Database (new v3 database — never touches legacy `fnb` DB)
DATABASE_URL=postgresql+asyncpg://fnb_user:fnb_pass@localhost:13334/fnb_enterprise_v3
DATABASE_URL_SYNC=postgresql+psycopg2://fnb_user:fnb_pass@localhost:13334/fnb_enterprise_v3

# Redis
REDIS_URL=redis://localhost:13335/1
REDIS_PASSWORD=

# Security
JWT_SECRET=change-me-in-production-min-32-chars-long
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=7
JWT_SECRET_PREVIOUS=

# Argon2id
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=4

# CORS
CORS_ORIGINS=http://localhost:13801,http://localhost:13802,http://localhost:13803

# Uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# Webhooks
WEBHOOK_API_KEY=whk-change-me
WEBHOOK_SIGNING_SECRET=whs-change-me

# MaxMind GeoIP
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=

# App mode
ENVIRONMENT=development
APP_NAME=FNB Enterprise v3
DEBUG=true

# ---------------------------------------------------------------------------
# Optional integrations (uncomment and fill when ready)
# ---------------------------------------------------------------------------

# Stripe payments
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...

# SMTP / Email
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=noreply@example.com
# SMTP_PASS=...
# SMTP_FROM=FNB Enterprise <noreply@example.com>

# AWS S3 / Object storage for uploads
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_S3_BUCKET=fnb-uploads
# AWS_S3_REGION=ap-southeast-1
# AWS_S3_ENDPOINT=

# SMS / OTP provider (Twilio)
# TWILIO_ACCOUNT_SID=...
# TWILIO_AUTH_TOKEN=...
# TWILIO_PHONE_NUMBER=+1234567890
