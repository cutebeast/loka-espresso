# FNB Enterprise v3 — Backend Environment
# NOTE: All runtime app settings (OTP bypass, feature flags, business rules)
# are stored in the `platform_config` table and managed via the admin API.
# This file is for infrastructure secrets and connection strings only.

# App mode
ENVIRONMENT=production
APP_NAME=FNB Enterprise v3
DEBUG=false

# Database (new v3 database — never touches legacy `fnb` DB)
DATABASE_URL=postgresql+asyncpg://fnb_user:change-me-strong-postgres-password@localhost:13334/fnb_enterprise_v3
# DATABASE_URL_SYNC is optional; if set, install psycopg2-binary.
# DATABASE_URL_SYNC=postgresql+psycopg2://fnb_user:change-me-strong-postgres-password@localhost:13334/fnb_enterprise_v3

# Redis
REDIS_URL=redis://:change-me-strong-redis-password@localhost:13335/0
REDIS_PASSWORD=change-me-strong-redis-password

# Security
JWT_SECRET=change-me-to-a-random-64-character-secret-minimum-thirty-two
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480
JWT_REFRESH_EXPIRE_DAYS=7
JWT_SECRET_PREVIOUS=

# Argon2id
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=4

# CORS (for production, use the exact HTTPS origins served by Caddy)
CORS_ORIGINS=https://app.lokaespresso.com,https://admin.lokaespresso.com,https://staff.lokaespresso.com
# CORS_ORIGINS=http://localhost:13830,http://localhost:13810,http://localhost:13820

# Trusted hosts (required in production; never leave empty)
TRUSTED_HOSTS=localhost,127.0.0.1,app.lokaespresso.com,admin.lokaespresso.com,staff.lokaespresso.com

# Uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# Webhooks
WEBHOOK_API_KEY=whk-change-me
WEBHOOK_SIGNING_SECRET=whs-change-me
GRABPAY_WEBHOOK_SECRET=whs-grabpay-change-me

# MaxMind GeoIP
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=

# ---------------------------------------------------------------------------
# Optional integrations (uncomment and fill when ready)
# ---------------------------------------------------------------------------

# Stripe payments
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
# Optional: defaults to the staff portal POS page
# STRIPE_CHECKOUT_SUCCESS_URL=https://staff.lokaespresso.com/pos
# STRIPE_CHECKOUT_CANCEL_URL=https://staff.lokaespresso.com/pos

# SMTP / Email
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=noreply@example.com
# SMTP_PASS=...
# SMTP_FROM=FNB Enterprise <noreply@example.com>

# AWS S3 / Object storage for uploads
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_S3_BUCKET=fnb-uploads
# AWS_S3_REGION=ap-southeast-1
# AWS_S3_ENDPOINT=

# Web Push (VAPID)
# VAPID_PUBLIC_KEY=...
# VAPID_PRIVATE_KEY=...
# VAPID_SUBJECT=mailto:admin@example.com

# SMS / OTP provider (Twilio)
# TWILIO_ACCOUNT_SID=...
# TWILIO_AUTH_TOKEN=...
# TWILIO_PHONE_NUMBER=+1234567890
